{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@spaceos/portal-ui": ["./packages/portal-ui/src/index.ts"],
      "@spaceos/portal-core": ["./packages/portal-core/src/index.ts"],
      "@spaceos/module-crm": ["./packages/module-crm/src/index.ts"],
      "@spaceos/module-crm/mocks": ["./packages/module-crm/src/mocks/index.ts"],
      "@spaceos/module-controlling": ["./packages/module-controlling/src/index.ts"],
      "@spaceos/module-controlling/mocks": ["./packages/module-controlling/src/mocks/index.ts"],
      "@spaceos/module-hr": ["./packages/module-hr/src/index.ts"],
      "@spaceos/module-hr/mocks": ["./packages/module-hr/src/mocks/index.ts"],
      "@spaceos/module-maintenance": ["./packages/module-maintenance/src/index.ts"],
      "@spaceos/module-maintenance/mocks": ["./packages/module-maintenance/src/mocks/index.ts"],
      "@spaceos/module-qa": ["./packages/module-qa/src/index.ts"],
      "@spaceos/module-qa/mocks": ["./packages/module-qa/src/mocks/index.ts"],
      "@spaceos/module-ehs": ["./packages/module-ehs/src/index.ts"],
      "@spaceos/module-ehs/mocks": ["./packages/module-ehs/src/mocks/index.ts"],
      "@spaceos/module-ehs/wizard": ["./packages/module-ehs/src/wizard/index.ts"],
      "@spaceos/module-dms": ["./packages/module-dms/src/index.ts"],
      "@spaceos/module-dms/mocks": ["./packages/module-dms/src/mocks/index.ts"],
      "@joinerytech/world-production": ["./packages/world-production/src/index.ts"],
      "@joinerytech/world-production/mocks": ["./packages/world-production/src/mocks/index.ts"],
      "@joinerytech/world-warehouse": ["./packages/world-warehouse/src/index.ts"],
      "@joinerytech/world-warehouse/mocks": ["./packages/world-warehouse/src/mocks/index.ts"]
    }
  },
  "include": ["src", "packages"]
}
